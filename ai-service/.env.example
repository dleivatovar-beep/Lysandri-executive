# ============================================================================
# CONFIGURACIÓN DE ENTORNO: LYSANDRI EXECUTIVE AI SERVICE (RAG & PGVECTOR)
# ============================================================================

# Conexión a Base de Datos PostgreSQL con pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lysandri_db
DB_USER=lysandri_admin
DB_PASSWORD=lysandri_admin_secret_2026

# Proveedores de LLM Gratuitos (Configurar al menos uno)
# Obtener clave gratuita de Groq: https://console.groq.com
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
# Obtener clave gratuita de Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Proveedor preferido: 'groq' o 'gemini'
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash

# Modelo de Embeddings (384 dimensiones)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Parámetros del Pipeline RAG
SIMILARITY_THRESHOLD=0.65
TOP_K=3
DOCS_DIR=data/docs

# Servidor FastAPI
PORT=8000
HOST=0.0.0.0
